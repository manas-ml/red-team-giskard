# Anthropic credentials (used by both the target agent and Giskard's judge/attacker)
ANTHROPIC_API_KEY=sk-ant-...

# Model for the system under test (AcmeBank Assistant)
ACME_TARGET_MODEL=claude-opus-5-5

# Model Giskard uses for scenario generation, attacker turns and LLM-as-judge.
# Must accept temperature=1.0 (Giskard always sends it): Sonnet/Haiku 5.5 do, Opus 5.5 does not.
GISKARD_MODEL=anthropic/claude-sonnet-5-5

# Opt out of Giskard's anonymous telemetry
DO_NOT_TRACK=1
